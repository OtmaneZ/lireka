/// Axe waterfall Profit bridge - 9 lignes figees, sans dependance aux faits.
/// Ordre | Libelle | Poste | Signe (+1 revenu, -1 cout). Aucune relation vers les autres tables.
/// Uniquement les postes de la formule de marge brute (Marc) : Prior year + 8 variations.
/// Total waterfall = [Marge Brute (reconstruit)] de la periode, a l'euro pres.
/// Retours / couts generiques exclus (hors marge brute).
table BridgePnL
	lineageTag: b7c8d9e0-f1a2-4b3c-9d0e-1f2a3b4c5d6e

	column Ordre
		dataType: int64
		formatString: 0
		lineageTag: b7c8d9e0-f1a2-4b3c-9d0e-1f2a3b4c5d6f
		summarizeBy: none
		sourceColumn: Ordre

	column Libelle
		dataType: string
		lineageTag: b7c8d9e0-f1a2-4b3c-9d0e-1f2a3b4c5d70
		summarizeBy: none
		sourceColumn: Libelle
		sortByColumn: Ordre

	column Poste
		dataType: string
		lineageTag: b7c8d9e0-f1a2-4b3c-9d0e-1f2a3b4c5d71
		summarizeBy: none
		sourceColumn: Poste

		changedProperty = IsHidden

	column Signe
		dataType: int64
		formatString: 0
		lineageTag: b7c8d9e0-f1a2-4b3c-9d0e-1f2a3b4c5d72
		summarizeBy: none
		sourceColumn: Signe

		changedProperty = IsHidden

	partition BridgePnL = m
		mode: import
		source =
				let
					// Postes de la formule de marge brute uniquement (AMONT inclus : sinon le Total
					// differe de la marge publiee de la variation du transport amont).
					Source = #table(
						type table [Ordre = Int64.Type, Libelle = text, Poste = text, Signe = Int64.Type],
						{
							{1, "Prior year", "MB_PY", 1},
							{2, "Revenue", "CA", 1},
							{3, "Shipping revenue", "PORT", 1},
							{4, "COGS", "ACHAT", -1},
							{5, "Inbound freight", "AMONT", -1},
							{6, "Outbound shipping", "OUTBOUND", -1},
							{7, "Duties and taxes", "DOUANES", -1},
							{8, "Marketplace fees", "COMMISSIONS", -1},
							{9, "Shipping supplies", "FOURNITURES", -1}
						}
					),
					#"Trie par Ordre" = Table.Sort(Source, {{"Ordre", Order.Ascending}})
				in
					#"Trie par Ordre"

	annotation PBI_ResultType = Table

