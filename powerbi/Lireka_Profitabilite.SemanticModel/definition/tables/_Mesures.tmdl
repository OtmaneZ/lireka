		lineageTag: 77778888-9999-0000-1111-222233334444

	measure 'Marge Brute (reconstruit) YoY %' =
			DIVIDE([Marge Brute (reconstruit)] - [Marge Brute (reconstruit) PY], ABS([Marge Brute (reconstruit) PY]))
