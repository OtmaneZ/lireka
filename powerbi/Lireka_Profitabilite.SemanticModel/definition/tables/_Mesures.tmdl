	/// Couleur colonne Gross Margin YoY (bps) des tableaux B2C / B2B : vert >= 0, rouge <= -100, neutre entre.
	measure 'B2C Couleur - GM YoY' =
			VAR bps = [B2C YoY - GM bps]
			RETURN
				SWITCH(
					TRUE(),
					NOT ISNUMBER(bps), BLANK(),
					bps >= 0, "#6FA84B",
					bps <= -100, "#C0504D",
					"#1B3A5C"
				)
		displayFolder: 06 Display (familles GV / B2C / Mkt)
		lineageTag: 0b5c1e2a-6f3d-4a41-9d7e-12c0a0000109

