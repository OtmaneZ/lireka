/// Dimension — type de commande (axe d'analyse du dashboard).
/// Dérivée des valeurs distinctes de customer_order.source (canal de vente).
/// Colonne canal : regroupement Finance (Website B2C / Website B2B / Marketplaces /
/// Librairie Arthaud / Other). Mapping validé provisoirement — PRO_WEBSITE = Website B2B
/// à confirmer avec Marc.
table dim_type_commande
	lineageTag: 429de86e-9e69-49ed-bcff-fcd4d672de50

	column type_commande
		dataType: string
		lineageTag: f494be33-15be-43b4-a792-bd6d6ed4d5c0
		summarizeBy: none
		sourceColumn: type_commande

		changedProperty = IsHidden

	column canal
		dataType: string
		lineageTag: c4d80b3e-bab1-4dbd-b1ef-e50399ec9c0d
		summarizeBy: none
		sourceColumn: canal
		sortByColumn: ordre_gv

		changedProperty = IsHidden

	column libelle
		dataType: string
		lineageTag: 6026a2bd-9ca5-474c-8514-bf4b6cf47a48
		summarizeBy: none
		sourceColumn: libelle

		changedProperty = IsHidden

	/// Ordre d'affichage General View — B2C (1) · B2B (2) · MP (3).
	column ordre_gv
		dataType: int64
		formatString: 0
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567899
		summarizeBy: sum
		sourceColumn: ordre_gv

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Canal pour les graphiques à barres empilées : Marketplaces en bas de la pile (demande Marc 27/10/2026).
	column canal_graphe
		dataType: string
		lineageTag: 574f0aa9-707e-44d1-96ce-f1734d255e7c
		summarizeBy: none
		sourceColumn: canal_graphe
		sortByColumn: ordre_graphe
		isHidden

	/// Ordre de pile des graphiques — Marketplaces (1) en bas · B2C (2) · B2B (3).
	column ordre_graphe
		dataType: int64
		formatString: 0
		lineageTag: beb19248-60df-4e76-8d4c-e8241f8ce22b
		summarizeBy: none
		sourceColumn: ordre_graphe
		isHidden

	partition dim_type_commande = m
		mode: import
		source =
				let
					// Sources distinctes calculées par PostgreSQL (customer_order, schéma PgSchema).
					#"Sources brutes" = Table.TransformColumnTypes(
						fnRequeteSql("SELECT DISTINCT source FROM " & PgSchema & ".customer_order"),
						{{"source", type text}}
					),
					#"Types normalises" = Table.AddColumn(
						#"Sources brutes",
						"type_commande",
						each if [source] = null or Text.Trim([source]) = "" then "INCONNU" else Text.Upper(Text.Trim([source])),
						type text
					),
					#"Valeurs distinctes" = Table.Distinct(Table.SelectColumns(#"Types normalises", {"type_commande"})),
					// Mapping Canal validé provisoirement — PRO_WEBSITE = Website B2B à confirmer avec Marc
					#"Canal ajoute" = Table.AddColumn(#"Valeurs distinctes", "canal", each
						let s = Text.Upper([type_commande]) in
						if s = "WEBSITE" then "Website B2C"
						else if s = "PRO_WEBSITE" then "Website B2B"
						else if Text.StartsWith(s, "AMAZON") or s = "CULTURA" or s = "RAKUTEN" or s = "FNAC" then "Marketplaces"
						else if s = "ARTHAUD" then "Librairie Arthaud"
						else "Other", type text),
					// Libellé lisible (underscores -> espaces, casse normalisée)
					#"Libelle ajoute" = Table.AddColumn(#"Canal ajoute", "libelle", each Text.Proper(Text.Replace([type_commande], "_", " ")), type text),
					// Ordre mockup General View : B2C · B2B · Marketplaces
					#"Ordre GV ajoute" = Table.AddColumn(
						#"Libelle ajoute",
						"ordre_gv",
						each
							if [canal] = "Website B2C" then 1
							else if [canal] = "Website B2B" then 2
							else if [canal] = "Marketplaces" then 3
							else if [canal] = "Librairie Arthaud" then 4
							else 99,
						Int64.Type
					),
					// Graphiques à barres empilées : la première valeur est en bas de la pile
					#"Ordre graphe ajoute" = Table.AddColumn(
						#"Ordre GV ajoute",
						"ordre_graphe",
						each
							if [canal] = "Marketplaces" then 1
							else if [canal] = "Website B2C" then 2
							else if [canal] = "Website B2B" then 3
							else if [canal] = "Librairie Arthaud" then 4
							else 99,
						Int64.Type
					),
					#"Canal graphe ajoute" = Table.AddColumn(#"Ordre graphe ajoute", "canal_graphe", each [canal], type text)
				in
					#"Canal graphe ajoute"

