/// Exécute une requête SQL native sur PostgreSQL (même source que la connexion passerelle).
/// Les jointures, agrégations et DISTINCT sont calculés par le serveur PostgreSQL :
/// la passerelle ne reçoit que le résultat et n'applique que les règles de ligne (typage, libellés).
expression fnRequeteSql =
		(requete as text) as table =>
		PostgreSQL.Database(PgServer, PgDatabase, [Query = requete])
	lineageTag: 28d009d9-e35f-4e0f-9847-973cc2cfb104

/// Normalise un transporteur à partir du numéro de suivi (tracking_id).
/// Méthode : inférence par motif, alignée sur l'analyse backend du 12/07/2026
/// (rapport_backend.txt). Sorties canoniques : UPS, La Poste, Postes Canada,
/// Chronopost, FedEx, DHL, Colis Privé, Unknown.
/// Limite connue : les identifiants purement numériques à 10 chiffres restent
/// ambigus (DHL minoritaire vs Unknown) et sont classés Unknown — à valider.
expression fnNormaliserTransporteur =
		(tracking as nullable text) as text =>
		let
			// Fix F-12 : nettoyage via fnNormaliserSuivi (majuscules + trim + NBSP).
			#"Suivi nettoye" = fnNormaliserSuivi(tracking),
			longueur = Text.Length(#"Suivi nettoye"),
			// Vrai si l'identifiant ne contient que des chiffres
			estNumerique = #"Suivi nettoye" <> "" and Text.Select(#"Suivi nettoye", {"0".."9"}) = #"Suivi nettoye",
			// Application des motifs identifiés lors de l'audit backend
			#"Transporteur infere" =
				if #"Suivi nettoye" = "" then "Unknown"
				else if Text.StartsWith(#"Suivi nettoye", "1Z") then "UPS"
				else if longueur = 13 and Text.StartsWith(#"Suivi nettoye", "6A") then "La Poste"
				else if Text.StartsWith(#"Suivi nettoye", "Q013") then "Postes Canada"
				else if longueur = 13 and (Text.StartsWith(#"Suivi nettoye", "XW") or Text.StartsWith(#"Suivi nettoye", "XA") or Text.StartsWith(#"Suivi nettoye", "XS") or Text.StartsWith(#"Suivi nettoye", "XR")) then "Chronopost"
				else if estNumerique and longueur = 18 then "FedEx"
				else if estNumerique and longueur = 12 then "DHL"
				else if Text.StartsWith(#"Suivi nettoye", "Z8") then "Colis Privé"
				else if Text.StartsWith(#"Suivi nettoye", "1C") then "Colis Privé"
				else if estNumerique and (longueur = 8 or longueur = 9) then "Colis Privé"
				else "Unknown"
		in
			#"Transporteur infere"
	lineageTag: f6ad5b17-1ad0-46b8-9616-eba1433a28c5

/// Réduit les alias textuels de transporteurs vers un libellé canonique.
/// Couvre les alias identifiés le 12/07/2026 : My Delivengo/Delivengo/Colissimo -> La Poste,
/// UPS Standard -> UPS, DHL EXPRESS -> DHL, Postes Canada/Canada Post -> Postes Canada.
expression fnCanonTransporteur =
		(libelle as nullable text) as text =>
		let
			// Fix F-12 : normalisation via fnNormaliserSuivi (clé de matching du libellé, NBSP inclus).
			#"Libelle nettoye" = fnNormaliserSuivi(libelle),
			#"Transporteur canon" =
				if List.Contains({"DHL", "DHL EXPRESS"}, #"Libelle nettoye") then "DHL"
				else if List.Contains({"UPS", "UPS STANDARD"}, #"Libelle nettoye") then "UPS"
				else if List.Contains({"FEDEX"}, #"Libelle nettoye") then "FedEx"
				else if List.Contains({"LA POSTE", "COLISSIMO", "MY DELIVENGO", "DELIVENGO"}, #"Libelle nettoye") then "La Poste"
				else if List.Contains({"COLIS PRIVE", "COLIS PRIVÉ"}, #"Libelle nettoye") then "Colis Privé"
				else if List.Contains({"CHRONOPOST"}, #"Libelle nettoye") then "Chronopost"
				else if List.Contains({"POSTES CANADA", "CANADA POST"}, #"Libelle nettoye") then "Postes Canada"
				else "Unknown"
		in
			#"Transporteur canon"
	lineageTag: 9274de39-62a4-4130-b72f-27746931dc50

/// Fix F-12 : normalisation robuste des clés textuelles de rapprochement.
/// Supprime les espaces insécables (NBSP U+00A0) fréquents dans les exports Excel/CSV FR,
/// applique Text.Trim puis passe en majuscules. Utilisée par fnNormaliserTransporteur
/// et fnCanonTransporteur (le rapprochement par numéro de suivi est fait par le backend).
expression fnNormaliserSuivi =
		(x as nullable text) as text =>
		let
			v = if x = null then "" else x,
			sansNbsp = Text.Replace(v, Character.FromNumber(160), " "),
			sansEspaces = Text.Trim(sansNbsp)
		in
			Text.Upper(sansEspaces)
	lineageTag: a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5e

/// Date de la dernière commande avec CA en base (jour UTC de max(origin_created), customer_order, order_amount_eur > 0).
/// Référence temporelle de dim_date (borne Fin du calendrier) et de la carte « Data through ».
/// Conversion identique à fact_commandes[date_commande] (étape "Date commande ajoutee").
/// Erreur explicite si la table est vide : un refresh ne doit pas publier une fenêtre vide.
expression DateDerniereCommande =
		let
			Source = fnRequeteSql("SELECT max(origin_created) AS derniere_commande FROM " & PgSchema & ".customer_order WHERE order_amount_eur > 0"),
			v = Source{0}[derniere_commande],
			d =
				if v = null then null
				else if Value.Is(v, type datetimezone) then DateTime.Date(DateTimeZone.RemoveZone(DateTimeZone.ToUtc(v)))
				else if Value.Is(v, type datetime) then DateTime.Date(v)
				else if Value.Is(v, type date) then v
				else try Date.FromText(Text.Start(Text.From(v), 10), [Format = "yyyy-MM-dd"]) otherwise null,
			Resultat =
				if d = null then error Error.Record("DateDerniereCommande", "aucune commande avec order_amount_eur > 0 dans customer_order")
				else d
		in
			Resultat
	lineageTag: 5e37419d-284f-4e0f-a980-aba4619829cb

	annotation PBI_ResultType = Date

/// Staging (non chargé) — lignes de factures transporteurs depuis analytics_views.v_carrier_invoice_lines.
/// Le backend COex rattache chaque ligne au colis (package_id) et à la commande (order_id) :
/// plus de rapprochement par numéro de suivi côté Power BI. Toutes les lignes sont conservées
/// (TRANSPORTATION, FUEL_SURCHARGE, OTHER_SURCHARGE, CREDIT) : aucune ligne de douane/taxe (vérifié le 30/09/2026).
expression stg_factures_brutes =
		let
			Source = PostgreSQL.Database(PgServer, PgDatabase){[Schema = PgSchema, Item = "v_carrier_invoice_lines"]}[Data],
			Colonnes = Table.SelectColumns(Source, {"invoice_date", "carrier_name", "service_code", "invoice_country_code", "weight_billed_grams", "amount_excl_vat_eur", "order_id", "package_id"}),
			Transformees = Table.TransformColumns(Colonnes, {
				{"invoice_date", each if _ = null then null else Date.From(_), type nullable date},
				{"carrier_name", each fnCanonTransporteur(_), type text},
				{"weight_billed_grams", each if _ = null then null else _ / 1000, type nullable number}
			}),
			Renommees = Table.RenameColumns(Transformees, {
				{"invoice_date", "date_facture"},
				{"carrier_name", "transporteur"}, {"service_code", "service"}, {"invoice_country_code", "pays_destination"},
				{"weight_billed_grams", "poids"}, {"amount_excl_vat_eur", "cout_transport"}, {"package_id", "id_package"}
			}),
			Types = Table.TransformColumnTypes(Renommees, {
				{"service", type text}, {"pays_destination", type text},
				{"cout_transport", type number}, {"order_id", Int64.Type}, {"id_package", Int64.Type}
			})
		in
			Types
	lineageTag: b8c9d0e1-f2a3-4b5c-0d1e-2f3a4b5c6d7e

/// Staging (non chargé) — lignes de factures transporteurs rattachées au colis par le backend.
/// Consommé par fact_factures_transport (fact_transport agrège les montants par colis en SQL).
/// nb_candidats_resolution : 1 si la ligne est rattachée à un colis, 0 sinon (compatibilité mesures).
expression stg_factures_transport_resolu =
		let
			Source = stg_factures_brutes,
			AvecNb = Table.AddColumn(Source, "nb_candidats_resolution", each if [id_package] = null then 0 else 1, type number),
			Colonnes = Table.SelectColumns(AvecNb, {
				"date_facture", "transporteur", "service",
				"pays_destination", "poids", "cout_transport", "order_id", "id_package",
				"nb_candidats_resolution"
			})
		in
			Colonnes
	lineageTag: f1a2b3c4-d5e6-4f7a-8b9c-0d1e2f3a4b5c

/// Staging (non chargé) — catalogue ISBN (title / author). Aucune source disponible en base à ce jour :
/// table vide, dim_isbn conserve les ISBN avec title/author null. À rebrancher sur une vue COex.
expression stg_catalogue_isbn =
		#table(type table [isbn = text, title = text, author = text], {})
	lineageTag: c4t4l0g-1111-2222-3333-444455550001

